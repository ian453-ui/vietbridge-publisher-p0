 func (a *LoginAction) CheckLoginStatus(ctx context.Context) (bool, error) {
-	// 加超时保护：只是查登录态的快速检查，不应无限挂（登录扫码的等待在 Login/WaitForLogin 里）
-	pp := a.page.Context(ctx).Timeout(30 * time.Second)
-	pp.MustNavigate("https://www.xiaohongshu.com/explore").MustWaitLoad()
-
-	time.Sleep(1 * time.Second)
-
-	exists, _, err := pp.Has(`.main-container .user .link-wrapper .channel`)
-	if err != nil {
-		return false, errors.Wrap(err, "check login status failed")
+	// Do not wait for the window load event: third-party images and scripts can
+	// keep it pending even after the account UI is already interactive.
+	probeCtx, cancel := context.WithTimeout(ctx, 25*time.Second)
+	defer cancel()
+	pp := a.page.Context(probeCtx)
+	if err := pp.Navigate("https://www.xiaohongshu.com/explore"); err != nil {
+		return false, errors.Wrap(err, "check login navigation failed")
 	}
-
-	if !exists {
-		return false, errors.Wrap(err, "login status element not found")
+	ticker := time.NewTicker(400 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		loggedIn, _, err := pp.Has(`.main-container .user .link-wrapper .channel`)
+		if err == nil && loggedIn {
+			return true, nil
+		}
+		loginPrompt, _, promptErr := pp.Has(`.login-container .qrcode-img`)
+		if promptErr == nil && loginPrompt {
+			return false, nil
+		}
+		select {
+		case <-probeCtx.Done():
+			return false, errors.Wrap(probeCtx.Err(), "check login status failed")
+		case <-ticker.C:
+		}
 	}
-
-	return true, nil
 }
 
